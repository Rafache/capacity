  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && npx --yes wrangler@4.81.0 pages deploy dist --project-name=kapa6t --branch=$(git branch --show-current)",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
